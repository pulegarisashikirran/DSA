
#include <stdio.h>
#include <stdlib.h>

#define INF 9999

int main()
{
    int n, **a, *visited;
    int min, u = -1, v = -1;
    int cost = 0, edges = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    a = malloc(n * sizeof(int *));

    for(int i = 0; i < n; i++)
        a[i] = malloc(n * sizeof(int));

    visited = calloc(n, sizeof(int));

    printf("Enter adjacency matrix (0 for no edge):\n");

    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);

            if(i != j && a[i][j] == 0)
                a[i][j] = INF;
        }
    }

    visited[0] = 1;

    printf("Edges in MST:\n");

    while(edges < n - 1)
    {
        min = INF;

        for(int i = 0; i < n; i++)
        {
            if(visited[i])
            {
                for(int j = 0; j < n; j++)
                {
                    if(!visited[j] && a[i][j] < min)
                    {
                        min = a[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        if(v == -1)
        {
            printf("MST not possible\n");
            break;
        }

        printf("%d - %d : %d\n", u, v, min);

        cost += min;
        visited[v] = 1;
        edges++;
    }

    if(edges == n - 1)
        printf("Minimum cost = %d\n", cost);

    for(int i = 0; i < n; i++)
        free(a[i]);

    free(a);
    free(visited);

    return 0;
}


